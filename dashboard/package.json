{
  "name": "dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201 --host 0.0.0.0",
    "backend": "python backend/server.py",
    "start:all": "concurrently -n api,ng -c blue,green \"npm run backend\" \"npm run start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:prod": "node serve-prod.js",
    "docker:deploy": "docker compose -f ../docker-compose.yml up -d --build frontend",
    "docker:deploy:all": "docker compose -f ../docker-compose.yml up -d --build",
    "docker:logs": "docker compose -f ../docker-compose.yml logs -f",
    "docker:down": "docker compose -f ../docker-compose.yml down"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "chart.js": "^4.4.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-financial": "^0.2.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@types/node": "^22.20.1",
    "concurrently": "^8.2.2",
    "typescript": "~5.9.3"
  }
}
