# Copy to .env and fill in (never commit .env):
#   cp .env.example .env
#
# All keys are OPTIONAL: helpers/config.py falls back to built-in defaults so the
# app runs without a .env. Override here to rotate secrets or point at other sources.

# --- Market / FX data (defaults baked into helpers/config.py) ---
# FINNHUB_TOKEN=
# FMV_API_KEY=
# FRANKFURTER_BASE=https://api.frankfurter.app
# FRANKFURTER_LATEST_URL=https://api.frankfurter.dev/v1/latest
# ER_API_URL=https://open.er-api.com/v6/latest/USD

# --- Database / backend (defaults: configs/nvShares.db, port 8080) ---
# NVSHARES_DB_PATH=
# PORT=8080

# --- Elasticsearch (legacy ELK push only) ---
# ELK_HOST=192.168.1.235
# ELK_PORT=9200

# ICICI Direct Breeze — from https://api.icicidirect.com (API registration)
BREEZE_API_KEY=
BREEZE_API_SECRET=
# Optional: public origin of this app (no trailing slash). Redirect URL in ICICI must be:
#   ${BREEZE_PUBLIC_BASE_URL}/api/breeze/callback
# If unset, the dashboard infers it from the API request (often fine for local use).
# BREEZE_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Angular dev server (match ICICI Redirect URL port), e.g.:
# BREEZE_PUBLIC_BASE_URL=http://localhost:4201
